{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judge analysis extension v0.4",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sides": {
      "type": "object",
      "properties": {
        "rider": {
          "type": "object",
          "properties": {
            "argument_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "assessment": {
              "enum": [
                "accepted",
                "partly_supported",
                "unsupported",
                "unresolved",
                "contradicted"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "policy_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "argument_refs",
            "assessment",
            "reason",
            "evidence_refs",
            "policy_refs"
          ],
          "additionalProperties": false
        },
        "driver": {
          "type": "object",
          "properties": {
            "argument_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "assessment": {
              "enum": [
                "accepted",
                "partly_supported",
                "unsupported",
                "unresolved",
                "contradicted"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "policy_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "argument_refs",
            "assessment",
            "reason",
            "evidence_refs",
            "policy_refs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rider",
        "driver"
      ],
      "additionalProperties": false
    },
    "disputed_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reasoning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "issue",
          "reasoning",
          "evidence_refs",
          "policy_refs"
        ],
        "additionalProperties": false
      }
    },
    "review_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "issue_code",
          "status",
          "explanation",
          "evidence_refs",
          "policy_refs"
        ],
        "additionalProperties": false
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "argument_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "argument_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assessment": {
            "enum": [
              "supported",
              "partly_supported",
              "contradicted",
              "insufficient_evidence",
              "unresolved",
              "not_factual_claim"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "supporting_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "opposing_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "missing_information": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "assessment_scope": {
            "type": "string",
            "enum": [
              "incident_fact",
              "communication_act"
            ]
          }
        },
        "required": [
          "argument_ref",
          "assessment",
          "reason",
          "supporting_evidence_refs",
          "opposing_evidence_refs",
          "policy_refs",
          "missing_information"
        ],
        "additionalProperties": false
      }
    },
    "decision_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "met",
              "not_met",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "condition_id",
          "status",
          "reason",
          "evidence_refs",
          "policy_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "precedent_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "policy_ref": {
            "type": "string"
          },
          "similarities": {
            "type": "string",
            "minLength": 1
          },
          "differences": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "policy_ref",
          "similarities",
          "differences"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "question",
    "sides",
    "disputed_points",
    "review_responses",
    "missing_information",
    "argument_assessments",
    "decision_conditions"
  ],
  "additionalProperties": false
}
