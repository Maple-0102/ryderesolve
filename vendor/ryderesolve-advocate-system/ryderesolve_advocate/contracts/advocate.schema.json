{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advocate Output v0.3 (backward-compatible provenance labels)",
  "type": "object",
  "required": [
    "case_id",
    "side",
    "claims"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "side": {
      "enum": [
        "rider",
        "driver"
      ]
    },
    "position": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_refs"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "party_statement",
              "system_record",
              "derived_calculation",
              "policy_application",
              "advocacy_inference"
            ]
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "reported",
              "recorded",
              "derived",
              "conditional",
              "unverified"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "counterpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_refs"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "party_statement",
              "system_record",
              "derived_calculation",
              "policy_application",
              "advocacy_inference"
            ]
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "reported",
              "recorded",
              "derived",
              "conditional",
              "unverified"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": true
}
