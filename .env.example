# Environment variables must be exported in your shell. This file is NOT auto-loaded.
# Full HTTPS Chat Completions endpoint from your chosen provider (not ADP SSE).
RYDE_JUDGE_ENDPOINT=
RYDE_JUDGE_MODEL=
RYDE_JUDGE_API_KEY=
RYDE_JUDGE_TIMEOUT=45

# Tencent ADP: publish the Judge app first. Environment takes precedence over .local/adp-app-key.
# Prefer `python -m ryde_resolve.adp_setup` for hidden local key entry.
ADP_APP_KEY=
ADP_CHAT_URL=https://wss.lke.tencentcloud.com/adp/v2/chat
ADP_TIMEOUT=120

# Google Cloud ADC adapter; no API key. .env is NOT auto-loaded.
# Project/model/location fall back to .local/vertex-config.json.
# RYDE_VERTEX_PROJECT=your-project-id
# RYDE_VERTEX_MODEL=gemini-3.8-flash
# RYDE_VERTEX_LOCATION=global
# RYDE_VERTEX_TIMEOUT=120
